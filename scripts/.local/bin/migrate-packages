#!/usr/bin/env bash
# migrate-packages
# Replay package manifests on this machine.
# Ubuntu/Debian: packages/apt.txt. Arch/Omarchy: packages/{pacman,aur}.txt.
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
APT="$DOTFILES/packages/apt.txt"
PAC="$DOTFILES/packages/pacman.txt"
AUR="$DOTFILES/packages/aur.txt"

DRY_RUN=0
if [[ "${1:-}" == "--dry-run" || "${1:-}" == "-n" ]]; then
    DRY_RUN=1
fi

install_apt_available() {
    local pkg missing=() installable=()
    for pkg in "$@"; do
        if dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'install ok installed'; then
            continue
        fi
        if apt-cache show "$pkg" >/dev/null 2>&1; then
            installable+=("$pkg")
        else
            missing+=("$pkg")
        fi
    done

    if [[ $DRY_RUN -eq 1 ]]; then
        printf '  would install: %s\n' "${installable[@]}"
    elif ((${#installable[@]})); then
        sudo apt-get install -y "${installable[@]}"
    fi

    if ((${#missing[@]})); then
        echo ">>> apt: unavailable in current repos, skipped: ${missing[*]}"
    fi
}

if command -v apt-get >/dev/null 2>&1; then
    if [[ ! -f "$APT" ]]; then
        echo "ERROR: $APT not found." >&2
        exit 1
    fi
    mapfile -t apt_pkgs < <(grep -vE '^\s*(#|$)' "$APT")
    echo ">>> apt: ${#apt_pkgs[@]} packages to install (or already present)."
    if [[ $DRY_RUN -eq 0 ]]; then
        sudo apt-get update
    fi
    install_apt_available "${apt_pkgs[@]}"
    echo ">>> Done."
    exit 0
fi

if ! command -v pacman >/dev/null 2>&1; then
    echo "ERROR: unsupported package manager." >&2
    exit 1
fi

if [[ ! -f "$PAC" ]]; then
    echo "ERROR: $PAC not found. Clone your dotfiles repo first." >&2
    exit 1
fi

PACMAN_FLAGS=(--needed --noconfirm --ask=4)

if [[ $DRY_RUN -eq 0 ]]; then
    sudo pacman -Syu --noconfirm --ask=4
fi

mapfile -t pac_pkgs < <(grep -vE '^\s*(#|$)' "$PAC")
echo ">>> pacman: ${#pac_pkgs[@]} packages to install (or already present)."
if [[ $DRY_RUN -eq 1 ]]; then
    printf '  would install: %s\n' "${pac_pkgs[@]}" | head -20
    echo "  (... truncated)"
else
    sudo pacman -S "${PACMAN_FLAGS[@]}" "${pac_pkgs[@]}"
fi

aur_helper=""
for helper in yay paru; do
    if command -v "$helper" >/dev/null 2>&1; then
        aur_helper="$helper"
        break
    fi
done

if [[ -z "$aur_helper" && $DRY_RUN -eq 0 ]]; then
    echo ">>> No AUR helper found; bootstrapping yay-bin..."
    tmp=$(mktemp -d)
    git clone --depth=1 https://aur.archlinux.org/yay-bin.git "$tmp/yay-bin"
    ( cd "$tmp/yay-bin" && makepkg -si --noconfirm )
    rm -rf "$tmp"
    aur_helper="yay"
fi

if [[ -s "$AUR" ]]; then
    mapfile -t aur_pkgs < <(grep -vE '^\s*(#|$)' "$AUR")
    echo ">>> AUR (via ${aur_helper:-<none>}): ${#aur_pkgs[@]} packages."
    if [[ $DRY_RUN -eq 1 ]]; then
        printf '  would install: %s\n' "${aur_pkgs[@]}"
    else
        "$aur_helper" -S --needed --noconfirm --ask=4 "${aur_pkgs[@]}"
    fi
fi

echo ">>> Done."
