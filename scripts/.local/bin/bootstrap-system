#!/usr/bin/env bash
# bootstrap-system
# Install the minimum packages needed to clone this environment and bring up
# the migrate / sync tooling on a fresh Arch / Omarchy machine.
set -euo pipefail

sudo pacman -Syu --noconfirm

sudo pacman -S --needed --noconfirm \
  stow \
  git \
  curl \
  unzip \
  zip \
  jq \
  base-devel \
  github-cli \
  docker \
  docker-buildx \
  nvm \
  openssh \
  rsync

# Make sure sshd is running so sync-projects / bootstrap-new-machine work.
sudo systemctl enable --now sshd
