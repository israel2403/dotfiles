#!/usr/bin/env bash
set -euo pipefail

if command -v ghostty >/dev/null 2>&1; then
  echo "Ghostty already installed: $(command -v ghostty)"
elif command -v apt-cache >/dev/null 2>&1 && apt-cache show ghostty >/dev/null 2>&1; then
  echo "Installing Ghostty with apt"
  sudo apt-get update
  sudo apt-get install -y ghostty
elif command -v pacman >/dev/null 2>&1; then
  echo "Installing Ghostty with pacman"
  sudo pacman -S --needed --noconfirm ghostty
else
  echo "Ghostty is not available from this machine's configured package manager."
  echo "Only the machine's selected Stow profile manages Ghostty configuration."
fi
