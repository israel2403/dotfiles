#!/usr/bin/env bash
# dotfiles-sync
# One-shot idempotent sync between ~/dotfiles and the local box.
#
# What it does, in order:
#   1. Pulls the latest commits from origin (auto-stashes a dirty tree first
#      and pops the stash afterwards). On merge conflicts the LOCAL side wins
#      ('-X ours'), matching the convention used by this repo.
#   2. Re-stows every package in the repo (`stow --restow`) so newly added
#      files appear and any drifted symlinks get re-pointed.
#   3. Sanity-checks against the .stow-global-ignore allow-list before stowing,
#      so an accidentally committed Omarchy/machine-specific file can't clobber
#      a real config.
#   4. Re-runs the idempotent helpers: link-omarchy-theme, migrate-packages,
#      bootstrap-zsh.
#   5. Reloads Hyprland if it is running, so window rules/keybindings take
#      effect immediately without a relogin.
#
# Use this command both for FIRST-TIME ongoing usage and DAILY updates --
# every step is a no-op if there's nothing to do.
#
# Usage:
#   dotfiles-sync           # full sync
#   dotfiles-sync --dry-run # show what would change, no writes
#   dotfiles-sync --no-pull # skip git pull (useful when offline)
#
# For a brand-new machine, run `bootstrap-new-machine` ONCE first; afterwards
# `dotfiles-sync` is the only command you ever need.

set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/dotfiles}"

DRY_RUN=0
DO_PULL=1
for arg in "$@"; do
    case "$arg" in
        -n|--dry-run) DRY_RUN=1 ;;
        --no-pull)    DO_PULL=0 ;;
        -h|--help)
            sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *) echo "unknown flag: $arg" >&2; exit 2 ;;
    esac
done

run() {
    if [[ $DRY_RUN -eq 1 ]]; then
        echo "DRY: $*"
    else
        eval "$@"
    fi
}

if [[ ! -d "$DOTFILES/.git" ]]; then
    echo "ERROR: $DOTFILES is not a git checkout." >&2
    echo "       For a fresh box, run bootstrap-new-machine first." >&2
    exit 1
fi

cd "$DOTFILES"

# -----------------------------------------------------------------------------
# 1. git pull (auto-stash, prefer-local on conflicts).
# -----------------------------------------------------------------------------
if [[ $DO_PULL -eq 1 ]]; then
    echo ">>> git fetch"
    run "git fetch --prune origin"

    DIRTY=0
    if ! git diff-index --quiet HEAD -- 2>/dev/null \
       || [[ -n "$(git ls-files --others --exclude-standard)" ]]; then
        DIRTY=1
        echo ">>> stashing local changes (auto-stash)"
        run "git stash push -u -m 'dotfiles-sync auto-stash $(date -Iseconds)'"
    fi

    echo ">>> git pull --no-rebase -X ours (local wins on conflict)"
    run "git pull --no-rebase -X ours --no-edit origin master"

    if [[ $DIRTY -eq 1 ]]; then
        echo ">>> restoring stashed local changes"
        if [[ $DRY_RUN -eq 0 ]]; then
            git stash pop || {
                echo "WARN: stash pop hit a conflict. Resolve manually:" >&2
                echo "      git status   # see conflicted files"          >&2
                echo "      git stash list" >&2
            }
        fi
    fi
else
    echo ">>> --no-pull: skipping git pull"
fi

# -----------------------------------------------------------------------------
# 2/3. stow every package, with an Omarchy-path safety net.
# -----------------------------------------------------------------------------
FORBIDDEN_RE='\.config/(hypr|waybar|mako|walker|alacritty|ghostty|kitty|omarchy|sddm|hypridle|hyprlock|hyprpicker|hyprsunset|swayosd|fcitx5|systemd)/|monitors\.conf|input\.conf'

packages=()
for pkg in */; do
    pkg="${pkg%/}"
    case "$pkg" in packages|.git) continue;; esac
    [[ -d "$pkg" ]] && packages+=("$pkg")
done

echo ">>> stow dry-run sanity check (${#packages[@]} packages)"
for pkg in "${packages[@]}"; do
    pkg_dry=$(stow -n -v --restow --target="$HOME" "$pkg" 2>&1 || true)
    if echo "$pkg_dry" | grep -E "$FORBIDDEN_RE" >/dev/null; then
        # A package may intentionally whitelist a protected path by carrying
        # a .stow-local-ignore (which overrides .stow-global-ignore for THAT
        # package only). Trust those packages.
        if [[ -f "$DOTFILES/$pkg/.stow-local-ignore" ]]; then
            continue
        fi
        echo "ERROR: stow package '$pkg' would write into a protected Omarchy path:" >&2
        echo "$pkg_dry" | grep -E "$FORBIDDEN_RE" | sed 's/^/  /' >&2
        echo "Add the path to .stow-global-ignore, drop the offending file, or" >&2
        echo "give the package a .stow-local-ignore that whitelists it intentionally." >&2
        exit 1
    fi
done

# Remove pre-existing ABSOLUTE symlinks under $HOME that already point into
# this repo. Stow only recognises its own RELATIVE symlinks as "owned"; an
# absolute symlink (e.g. created by an old `ln -s ~/dotfiles/...` step or by a
# tool that auto-installs into $HOME) makes stow refuse with
#   "existing target is not owned by stow"
# even though the link points at the same file. Replacing them with stow's
# own relative symlinks is safe and idempotent.
preflight_clean_absolute_symlinks() {
    local pkg=$1
    local pkg_dir="$DOTFILES/$pkg"
    local cleaned=0

    # Only act on truly ABSOLUTE symlinks (link value starts with '/'). Stow's
    # own RELATIVE symlinks also resolve into $DOTFILES, but they're owned by
    # stow and must be left alone -- otherwise we'd churn every file every run.
    _is_absolute_repo_symlink() {
        local p=$1
        [[ -L "$p" ]] || return 1
        local link_value
        link_value=$(readlink "$p" 2>/dev/null || true)
        [[ "$link_value" == /* ]] || return 1   # not absolute -> not ours to touch
        local resolved
        resolved=$(readlink -f "$p" 2>/dev/null || true)
        [[ "$resolved" == "$DOTFILES"/* ]]
    }

    # 1. Direct file targets that exist as absolute symlinks into the repo.
    while IFS= read -r -d '' src; do
        local rel="${src#$pkg_dir/}"
        local tgt="$HOME/$rel"
        _is_absolute_repo_symlink "$tgt" || continue
        if [[ $DRY_RUN -eq 1 ]]; then
            echo "    DRY: would unlink absolute symlink ~${tgt#$HOME}"
        else
            rm -f "$tgt"
            echo "    cleaned absolute symlink: ~${tgt#$HOME}"
        fi
        cleaned=$((cleaned+1))
    done < <(find "$pkg_dir" -type f -print0)

    # 2. Parent dirs that are themselves absolute symlinks into the repo
    #    (e.g. ~/.config/fff -> ~/dotfiles/fff/.config/fff). One such link
    #    shadows every file inside it, so we only need to walk parents of
    #    the package's first file.
    while IFS= read -r -d '' src; do
        local rel="${src#$pkg_dir/}"
        local parent
        parent=$(dirname "$HOME/$rel")
        while [[ "$parent" != "$HOME" && "$parent" != "/" && -e "$parent" ]]; do
            if _is_absolute_repo_symlink "$parent"; then
                if [[ $DRY_RUN -eq 1 ]]; then
                    echo "    DRY: would unlink absolute symlink dir ~${parent#$HOME}"
                else
                    rm -f "$parent"
                    echo "    cleaned absolute symlink (dir): ~${parent#$HOME}"
                fi
                cleaned=$((cleaned+1))
                break
            fi
            parent=$(dirname "$parent")
        done
    done < <(find "$pkg_dir" -type f -print0)

    return 0
}

for pkg in "${packages[@]}"; do
    echo ">>> stow --restow $pkg"
    preflight_clean_absolute_symlinks "$pkg"
    if [[ $DRY_RUN -eq 1 ]]; then
        stow -n -v --restow --target="$HOME" "$pkg" || true
    else
        stow --restow --target="$HOME" "$pkg"
    fi
done

# -----------------------------------------------------------------------------
# 4. Idempotent helpers.
#    Resolve helpers via PATH if available, otherwise fall back to the
#    in-repo location -- this matters on a fresh box where ~/.local/bin
#    has been stowed but the current shell hasn't picked up the new PATH.
# -----------------------------------------------------------------------------
resolve_helper() {
    local name=$1
    if command -v "$name" >/dev/null 2>&1; then
        command -v "$name"
    elif [[ -x "$DOTFILES/scripts/.local/bin/$name" ]]; then
        echo "$DOTFILES/scripts/.local/bin/$name"
    fi
}

LINK_OMARCHY=$(resolve_helper link-omarchy-theme)
MIGRATE_PKGS=$(resolve_helper migrate-packages)
BOOTSTRAP_ZSH=$(resolve_helper bootstrap-zsh)

if [[ -n "$LINK_OMARCHY" ]]; then
    echo ">>> link-omarchy-theme"
    run "$LINK_OMARCHY"
fi

if [[ -n "$MIGRATE_PKGS" ]]; then
    echo ">>> migrate-packages"
    if [[ $DRY_RUN -eq 1 ]]; then
        run "$MIGRATE_PKGS --dry-run"
    else
        run "$MIGRATE_PKGS"
    fi
fi

if [[ -n "$BOOTSTRAP_ZSH" ]]; then
    echo ">>> bootstrap-zsh"
    run "$BOOTSTRAP_ZSH"
fi

# -----------------------------------------------------------------------------
# 5. Reload Hyprland if it's running.
# -----------------------------------------------------------------------------
if command -v hyprctl >/dev/null 2>&1 && pgrep -x Hyprland >/dev/null 2>&1; then
    echo ">>> hyprctl reload"
    run "hyprctl reload >/dev/null"
fi

echo
echo "✔ dotfiles-sync complete."
