#!/usr/bin/env bash
# dotfiles-sync
# One-shot idempotent sync between ~/dotfiles and the local box.
#
# What it does, in order:
#   1. Pulls the latest commits from origin (auto-stashes a dirty tree first
#      and pops the stash afterwards). On merge conflicts the LOCAL side wins
#      ('-X ours'), matching the convention used by this repo.
#   2. Re-stows every package in the repo (`stow --restow`) so newly added
#      files appear and any drifted symlinks get re-pointed.
#   3. Sanity-checks against the .stow-global-ignore allow-list before stowing,
#      so an accidentally committed Omarchy/machine-specific file can't clobber
#      a real config.
#   4. Re-runs the idempotent helpers: link-omarchy-theme, migrate-packages,
#      bootstrap-zsh.
#   5. Reloads Hyprland if it is running, so window rules/keybindings take
#      effect immediately without a relogin.
#
# Use this command both for FIRST-TIME ongoing usage and DAILY updates --
# every step is a no-op if there's nothing to do.
#
# Usage:
#   dotfiles-sync           # full sync (safe: divergent files are backed up)
#   dotfiles-sync --force   # repo wins, no backup -- clobber local divergence
#   dotfiles-sync --dry-run # show what would change, no writes
#   dotfiles-sync --no-pull # skip git pull (useful when offline)
#
# By default, when a target file under $HOME differs from the repo it is moved
# to <path>.pre-stow.<unix-ts> before stow takes over, so nothing is silently
# lost. Pass --force when this box is fully untrusted vs the repo (e.g. you've
# verified the source-of-truth box is correct and want to clobber whatever the
# other box has) -- divergent files are deleted with no backup.
#
# For a brand-new machine, run `bootstrap-new-machine` ONCE first; afterwards
# `dotfiles-sync` is the only command you ever need.

set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/dotfiles}"

DRY_RUN=0
DO_PULL=1
FORCE=0
for arg in "$@"; do
    case "$arg" in
        -n|--dry-run) DRY_RUN=1 ;;
        --no-pull)    DO_PULL=0 ;;
        -f|--force)   FORCE=1 ;;
        -h|--help)
            sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *) echo "unknown flag: $arg" >&2; exit 2 ;;
    esac
done

if [[ $FORCE -eq 1 ]]; then
    echo "!! --force enabled: divergent local files will be DELETED, not backed up."
fi

run() {
    if [[ $DRY_RUN -eq 1 ]]; then
        echo "DRY: $*"
    else
        eval "$@"
    fi
}

if [[ ! -d "$DOTFILES/.git" ]]; then
    echo "ERROR: $DOTFILES is not a git checkout." >&2
    echo "       For a fresh box, run bootstrap-new-machine first." >&2
    exit 1
fi

# Always tell Hyprland to reload on exit -- even if a later step (e.g.
# migrate-packages hitting a pacman conflict) fails. Stow may have unlinked
# and re-linked config files mid-run, and Hyprland's inotify auto-reload can
# fire while a file is briefly missing, leaving the running compositor in a
# transient "Config error: source= globbing error: found no match" state.
# A final hyprctl reload clears that, so we install it as an EXIT trap.
final_hyprctl_reload() {
    if [[ $DRY_RUN -eq 0 ]] \
       && command -v hyprctl >/dev/null 2>&1 \
       && pgrep -x Hyprland >/dev/null 2>&1; then
        echo ">>> hyprctl reload (final)"
        hyprctl reload >/dev/null 2>&1 || true
    fi
}
trap final_hyprctl_reload EXIT

cd "$DOTFILES"

# -----------------------------------------------------------------------------
# 1. git pull (auto-stash, prefer-local on conflicts).
# -----------------------------------------------------------------------------
if [[ $DO_PULL -eq 1 ]]; then
    echo ">>> git fetch"
    run "git fetch --prune origin"

    DIRTY=0
    if ! git diff-index --quiet HEAD -- 2>/dev/null \
       || [[ -n "$(git ls-files --others --exclude-standard)" ]]; then
        DIRTY=1
        echo ">>> stashing local changes (auto-stash)"
        run "git stash push -u -m 'dotfiles-sync auto-stash $(date -Iseconds)'"
    fi

    echo ">>> git pull --no-rebase -X ours (local wins on conflict)"
    run "git pull --no-rebase -X ours --no-edit origin master"

    if [[ $DIRTY -eq 1 ]]; then
        echo ">>> restoring stashed local changes"
        if [[ $DRY_RUN -eq 0 ]]; then
            git stash pop || {
                echo "WARN: stash pop hit a conflict. Resolve manually:" >&2
                echo "      git status   # see conflicted files"          >&2
                echo "      git stash list" >&2
            }
        fi
    fi
else
    echo ">>> --no-pull: skipping git pull"
fi

# -----------------------------------------------------------------------------
# 2/3. stow every package, with an Omarchy-path safety net.
# -----------------------------------------------------------------------------
FORBIDDEN_RE='\.config/(hypr|waybar|mako|walker|alacritty|ghostty|kitty|omarchy|sddm|hypridle|hyprlock|hyprpicker|hyprsunset|swayosd|fcitx5|systemd)/|monitors\.conf|input\.conf'

packages=()
for pkg in */; do
    pkg="${pkg%/}"
    case "$pkg" in packages|.git) continue;; esac
    [[ -d "$pkg" ]] && packages+=("$pkg")
done

echo ">>> stow dry-run sanity check (${#packages[@]} packages)"
for pkg in "${packages[@]}"; do
    pkg_dry=$(stow -n -v --restow --target="$HOME" "$pkg" 2>&1 || true)
    if echo "$pkg_dry" | grep -E "$FORBIDDEN_RE" >/dev/null; then
        # A package may intentionally whitelist a protected path by carrying
        # a .stow-local-ignore (which overrides .stow-global-ignore for THAT
        # package only). Trust those packages.
        if [[ -f "$DOTFILES/$pkg/.stow-local-ignore" ]]; then
            continue
        fi
        echo "ERROR: stow package '$pkg' would write into a protected Omarchy path:" >&2
        echo "$pkg_dry" | grep -E "$FORBIDDEN_RE" | sed 's/^/  /' >&2
        echo "Add the path to .stow-global-ignore, drop the offending file, or" >&2
        echo "give the package a .stow-local-ignore that whitelists it intentionally." >&2
        exit 1
    fi
done

# Resolve pre-existing conflicts that would make stow abort. Two kinds of
# blocker, both common when replicating dotfiles to a box that already had a
# manual setup or where another tool wrote default configs:
#
#   1. Absolute symlinks under $HOME pointing into ~/dotfiles. Stow only
#      recognises its own RELATIVE symlinks as "owned"; absolute ones cause
#      "existing target is not owned by stow" even though they point at the
#      same file. Replace them with stow's relative symlinks.
#   2. Regular files at the target path (e.g. ~/.config/hypr/bindings.conf
#      written by Omarchy's defaults). Stow refuses to clobber them. We
#      compare contents with the repo: if identical, drop the local copy; if
#      they differ, move the local copy to <path>.pre-stow.<timestamp> so
#      nothing is silently lost, then let stow take over.
#
# Stow's own relative symlinks are explicitly left alone, so re-running on a
# clean box is a no-op.
PRESTOW_TS=$(date +%s)
preflight_resolve_conflicts() {
    local pkg=$1
    local pkg_dir="$DOTFILES/$pkg"

    _is_absolute_repo_symlink() {
        local p=$1
        [[ -L "$p" ]] || return 1
        local link_value
        link_value=$(readlink "$p" 2>/dev/null || true)
        [[ "$link_value" == /* ]] || return 1
        local resolved
        resolved=$(readlink -f "$p" 2>/dev/null || true)
        [[ "$resolved" == "$DOTFILES"/* ]]
    }

    _do_rm() {
        if [[ $DRY_RUN -eq 1 ]]; then echo "    DRY: $1"; else rm -f "$2"; echo "    $1"; fi
    }
    _do_mv() {
        if [[ $DRY_RUN -eq 1 ]]; then echo "    DRY: $1"; else mv "$2" "$3"; echo "    $1"; fi
    }

    # Per-file: existing absolute repo symlink OR existing regular file.
    while IFS= read -r -d '' src; do
        local rel="${src#$pkg_dir/}"
        local tgt="$HOME/$rel"
        if _is_absolute_repo_symlink "$tgt"; then
            _do_rm "cleaned absolute symlink: ~${tgt#$HOME}" "$tgt"
        elif [[ -f "$tgt" && ! -L "$tgt" ]]; then
            # Skip files that are ALREADY reached via a tree-folded parent
            # symlink into the repo (e.g. ~/.config/fff -> ~/dotfiles/.../fff).
            # Such files aren't symlinks themselves but their canonical path is
            # inside $DOTFILES, meaning stow already manages them via the parent.
            local resolved
            resolved=$(readlink -f "$tgt" 2>/dev/null || true)
            if [[ "$resolved" == "$DOTFILES"/* ]]; then
                continue
            fi
            if cmp -s "$src" "$tgt"; then
                _do_rm "dropped identical pre-existing file: ~${tgt#$HOME}" "$tgt"
            elif [[ $FORCE -eq 1 ]]; then
                _do_rm "force-removed divergent file (no backup): ~${tgt#$HOME}" "$tgt"
            else
                local backup="${tgt}.pre-stow.${PRESTOW_TS}"
                _do_mv "backed up divergent file: ~${tgt#$HOME} -> ~${backup#$HOME}" "$tgt" "$backup"
            fi
        fi
    done < <(find "$pkg_dir" -type f -print0)

    # Parent dirs that are themselves absolute symlinks into the repo, e.g.
    # ~/.config/fff -> ~/dotfiles/fff/.config/fff -- one such link shadows
    # every file inside it.
    while IFS= read -r -d '' src; do
        local rel="${src#$pkg_dir/}"
        local parent
        parent=$(dirname "$HOME/$rel")
        while [[ "$parent" != "$HOME" && "$parent" != "/" && -e "$parent" ]]; do
            if _is_absolute_repo_symlink "$parent"; then
                _do_rm "cleaned absolute symlink (dir): ~${parent#$HOME}" "$parent"
                break
            fi
            parent=$(dirname "$parent")
        done
    done < <(find "$pkg_dir" -type f -print0)
}

for pkg in "${packages[@]}"; do
    echo ">>> stow --restow $pkg"
    preflight_resolve_conflicts "$pkg"
    if [[ $DRY_RUN -eq 1 ]]; then
        stow -n -v --restow --target="$HOME" "$pkg" || true
    else
        stow --restow --target="$HOME" "$pkg"
    fi
done

# -----------------------------------------------------------------------------
# 4. Idempotent helpers.
#    Resolve helpers via PATH if available, otherwise fall back to the
#    in-repo location -- this matters on a fresh box where ~/.local/bin
#    has been stowed but the current shell hasn't picked up the new PATH.
# -----------------------------------------------------------------------------
resolve_helper() {
    local name=$1
    if command -v "$name" >/dev/null 2>&1; then
        command -v "$name"
    elif [[ -x "$DOTFILES/scripts/.local/bin/$name" ]]; then
        echo "$DOTFILES/scripts/.local/bin/$name"
    fi
}

LINK_OMARCHY=$(resolve_helper link-omarchy-theme)
MIGRATE_PKGS=$(resolve_helper migrate-packages)
BOOTSTRAP_ZSH=$(resolve_helper bootstrap-zsh)

if [[ -n "$LINK_OMARCHY" ]]; then
    echo ">>> link-omarchy-theme"
    run "$LINK_OMARCHY"
fi

if [[ -n "$MIGRATE_PKGS" ]]; then
    echo ">>> migrate-packages"
    if [[ $DRY_RUN -eq 1 ]]; then
        run "$MIGRATE_PKGS --dry-run"
    else
        run "$MIGRATE_PKGS"
    fi
fi

if [[ -n "$BOOTSTRAP_ZSH" ]]; then
    echo ">>> bootstrap-zsh"
    run "$BOOTSTRAP_ZSH"
fi

# -----------------------------------------------------------------------------
# 5. Final Hyprland reload is handled by the EXIT trap installed near the top.
# -----------------------------------------------------------------------------

echo
echo "✔ dotfiles-sync complete."
