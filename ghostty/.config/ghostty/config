theme = TokyoNight Night

font-family = "JetBrains Mono"
font-size = 12
font-feature = calt, liga, dlig

command = /usr/bin/zsh

window-padding-x = 10
window-padding-y = 10

background-blur-radius = 12
background-opacity = 0.85

mouse-hide-while-typing = true
mouse-scroll-multiplier = 2
copy-on-select = clipboard

keybind = alt+enter=toggle_fullscreen
keybind = alt+f=esc:f
keybind = alt+==increase_font_size:1
keybind = alt+-=decrease_font_size:1
keybind = alt+0=reset_font_size
keybind = ctrl+shift+t=new_tab
keybind = ctrl+w=close_tab:this
keybind = ctrl+page_down=next_tab
keybind = ctrl+page_up=previous_tab
keybind = ctrl+n=new_window
keybind = ctrl+shift+c=copy_to_clipboard:mixed
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+f=start_search
